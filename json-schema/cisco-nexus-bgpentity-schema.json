{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BgpEntity",
  "title": "BgpEntity",
  "type": "object",
  "description": "Top-level BGP entity managed object. DN is sys/bgp.",
  "properties": {
    "attributes": {
      "type": "object",
      "properties": {
        "dn": {
          "type": "string",
