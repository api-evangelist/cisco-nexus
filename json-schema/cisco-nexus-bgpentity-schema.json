          ]
        },
        "adminSt": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled"
          ]
        }
      },
      "example": "example_value"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/BgpInst"
      },
      "example": []
    }
  }
}