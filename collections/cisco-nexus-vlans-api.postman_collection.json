        {
          "id": "e3499118-c94e-41d6-88c5-a67c52252fae",
          "name": "Create or Modify a Vlan Bridge Domain",
          "request": {
            "name": "Create or Modify a Vlan Bridge Domain",
            "description": {
              "content": "Creates or modifies VLAN bridge domains using the bdEntity container with l2BD child objects. The fabEncap attribute specifies the VLAN ID in the format vlan-{id}. Supports VLAN naming and pcTag assignment.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mo",
                "sys",
                "bd.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Management IP address or hostname of the Nexus switch",
                  "type": "any",
                  "value": "{{switchIp}}",
                  "key": "switchIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bdEntity\": {\n    \"children\": [\n      {\n        \"l2BD\": {\n          \"attributes\": {\n            \"dn\": \"<string>\",\n            \"fabEncap\": \"<string>\",\n            \"name\": \"<string>\",\n            \"pcTag\": \"<string>\",\n            \"adminSt\": \"<string>\",\n            \"operSt\": \"<string>\",\n            \"id\": \"<string>\",\n            \"modTs\": \"<dateTime>\"\n          }\n        }\n      },\n      {\n        \"l2BD\": {\n          \"attributes\": {\n            \"dn\": \"<string>\",\n            \"fabEncap\": \"<string>\",\n            \"name\": \"<string>\",\n            \"pcTag\": \"<string>\",\n            \"adminSt\": \"<string>\",\n            \"operSt\": \"<string>\",\n            \"id\": \"<string>\",\n            \"modTs\": \"<dateTime>\"\n          }\n        }\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "7eeb561e-a657-4a08-834b-50e1b1cbb48e",
              "name": "VLAN created or modified successfully",
              "originalRequest": {
