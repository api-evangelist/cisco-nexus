                  "mode": "raw",
                  "raw": "{\n  \"bdEntity\": {\n    \"children\": [\n      {\n        \"l2BD\": {\n          \"attributes\": {\n            \"fabEncap\": \"vlan-100\",\n            \"name\": \"Production\",\n            \"pcTag\": \"1\"\n          }\n        }\n      }\n    ]\n  }\n}",
