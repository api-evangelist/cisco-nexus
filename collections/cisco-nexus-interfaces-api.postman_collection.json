        {
          "id": "ac56d37b-4d22-45f0-8225-56ac93298081",
          "name": "Configure a Physical Ethernet Interface",
          "request": {
            "name": "Configure a Physical Ethernet Interface",
            "description": {
              "content": "Creates or modifies the configuration of one or more physical Ethernet interfaces. The payload uses the interfaceEntity container with l1PhysIf child objects. Properties include administrative state, speed, duplex, MTU, layer mode, switchport mode, access VLAN, trunk VLANs, and description.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mo",
                "sys",
                "intf.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Management IP address or hostname of the Nexus switch",
                  "type": "any",
                  "value": "{{switchIp}}",
                  "key": "switchIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interfaceEntity\": {\n    \"children\": [\n      {\n        \"l1PhysIf\": {\n          \"attributes\": {\n            \"dn\": \"<string>\",\n            \"id\": \"<string>\",\n            \"adminSt\": \"<string>\",\n            \"operSt\": \"<string>\",\n            \"layer\": \"<string>\",\n            \"mode\": \"<string>\",\n            \"accessVlan\": \"<string>\",\n            \"trunkVlans\": \"<string>\",\n            \"nativeVlan\": \"<string>\",\n            \"speed\": \"<string>\",\n            \"duplex\": \"<string>\",\n            \"mtu\": \"<string>\",\n            \"descr\": \"<string>\",\n            \"snmpTrapSt\": \"<string>\",\n            \"modTs\": \"<dateTime>\"\n          }\n        }\n      },\n      {\n        \"l1PhysIf\": {\n          \"attributes\": {\n            \"dn\": \"<string>\",\n            \"id\": \"<string>\",\n            \"adminSt\": \"<string>\",\n            \"operSt\": \"<string>\",\n            \"layer\": \"<string>\",\n            \"mode\": \"<string>\",\n            \"accessVlan\": \"<string>\",\n            \"trunkVlans\": \"<string>\",\n            \"nativeVlan\": \"<string>\",\n            \"speed\": \"<string>\",\n            \"duplex\": \"<string>\",\n            \"mtu\": \"<string>\",\n            \"descr\": \"<string>\",\n            \"snmpTrapSt\": \"<string>\",\n            \"modTs\": \"<dateTime>\"\n          }\n        }\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6eb004e2-c157-44dd-b32b-0975d5aef35e",
              "name": "Configuration applied successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "mo",
                    "sys",
                    "intf.json"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Management IP address or hostname of the Nexus switch",
                      "type": "any",
                      "value": "{{switchIp}}",
                      "key": "switchIp"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "APIC-cookie",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"interfaceEntity\": {\n    \"children\": [\n      {\n        \"l1PhysIf\": {\n          \"attributes\": {\n            \"id\": \"eth1/1\",\n            \"adminSt\": \"up\",\n            \"layer\": \"Layer2\",\n            \"mode\": \"access\",\n            \"accessVlan\": \"vlan-100\",\n            \"descr\": \"Server port\"\n          }\n        }\n      }\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
