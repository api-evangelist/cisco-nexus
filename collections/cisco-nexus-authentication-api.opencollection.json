{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco NX-API REST Authentication API",
    "version": "10.5.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "APIC-cookie",
      "value": "{{APIC-cookie}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate and Obtain Session Cookie",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{switchIp}/api/aaaLogin.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a user against the NX-OS local or remote AAA database and returns a session cookie (APIC-cookie) used for subsequent API requests. The cookie has a configurable idle timeout (default 600 seconds)."
        },
        {
          "info": {
            "name": "Terminate Authenticated Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{switchIp}/api/aaaLogout.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Ends the current authenticated session and invalidates the session cookie."
        }
      ]
    }
  ],
  "bundled": true
}