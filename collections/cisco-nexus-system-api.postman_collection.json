        {
          "id": "65527db7-2705-4a87-9c18-137943398a33",
          "name": "Enable or Disable Nx-os Features",
          "request": {
            "name": "Enable or Disable Nx-os Features",
            "description": {
              "content": "Manages NX-OS feature activation using the fmEntity container. Features include interface-vlan (fmInterfaceVlan), BGP (fmBgp), OSPF (fmOspf), LACP (fmLacp), and others. Each feature has an adminSt property that accepts enabled or disabled.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mo",
                "sys",
                "fm.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Management IP address or hostname of the Nexus switch",
                  "type": "any",
                  "value": "{{switchIp}}",
                  "key": "switchIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fmEntity\": {\n    \"children\": [\n      \"<object>\",\n      \"<object>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9ab7e69f-63ed-4c46-8f91-9107ad8d1dcf",
              "name": "Feature configuration applied",
              "originalRequest": {
                "url": {
                  "path": [
                    "mo",
                    "sys",
                    "fm.json"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Management IP address or hostname of the Nexus switch",
                      "type": "any",
                      "value": "{{switchIp}}",
                      "key": "switchIp"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "APIC-cookie",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fmEntity\": {\n    \"children\": [\n      {\n        \"fmInterfaceVlan\": {\n          \"attributes\": {\n            \"adminSt\": \"enabled\"\n          }\n        }\n      },\n      {\n        \"fmBgp\": {\n          \"attributes\": {\n            \"adminSt\": \"enabled\"\n          }\n        }\n      }\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
