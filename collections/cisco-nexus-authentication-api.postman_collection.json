      "item": [
        {
          "id": "4bc27256-fd2b-4d66-8636-9383ce2ee851",
          "name": "Authenticate and Obtain Session Cookie",
          "request": {
            "name": "Authenticate and Obtain Session Cookie",
            "description": {
              "content": "Authenticates a user against the NX-OS local or remote AAA database and returns a session cookie (APIC-cookie) used for subsequent API requests. The cookie has a configurable idle timeout (default 600 seconds).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "aaaLogin.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Management IP address or hostname of the Nexus switch",
                  "type": "any",
                  "value": "{{switchIp}}",
                  "key": "switchIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aaaUser\": {\n    \"attributes\": {\n      \"name\": \"<string>\",\n      \"pwd\": \"<password>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "2b6085f4-3b41-46f3-b89a-74b68f87716e",
              "name": "Authentication successful",
              "originalRequest": {
